# RAGForge configuration. Copy to .env and edit as needed.
# All variables are optional; sensible defaults are built in.

# Ollama endpoint. Leave empty to auto-detect (localhost, then the WSL host gateway).
# From WSL2 with Ollama on Windows, this is typically http://<host-gateway>:11434
OLLAMA_BASE_URL=

# Chat + embedding models installed in Ollama.
RAGFORGE_CHAT_MODEL=qwen2.5-coder:3b-instruct-q8_0
RAGFORGE_EMBED_MODEL=nomic-embed-text
RAGFORGE_ALLOW_FALLBACK_EMBEDDINGS=true

# Storage
RAGFORGE_DATA_DIR=data

# Chunking
RAGFORGE_CHUNK_SIZE=900
RAGFORGE_CHUNK_OVERLAP=150
RAGFORGE_MIN_CHUNK_CHARS=40

# Retrieval
RAGFORGE_TOP_K=6
RAGFORGE_DENSE_K=12
RAGFORGE_BM25_K=12
RAGFORGE_MMR_LAMBDA=0.8

# Generation
RAGFORGE_TEMPERATURE=0.2
RAGFORGE_MAX_CONTEXT_CHARS=12000
RAGFORGE_MAX_HISTORY_MESSAGES=6
RAGFORGE_NUM_CTX=8192

# Limits
RAGFORGE_MAX_UPLOAD_MB=50
RAGFORGE_REQUEST_TIMEOUT=180
